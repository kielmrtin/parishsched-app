<?xml version="1.0" encoding="utf-8"?>
<!-- This is the layer that actually renders on the real device, confirmed
     by a photo of it: the church icon appears here regardless of the API
     31+ SplashScreen theme attrs in values-v31/styles.xml (this OEM skin
     doesn't seem to honor those), so the branded icon+text image
     (drawable-nodpi/splash_brand.png, generated by
     tool/generate_splash_with_text.js) is layered here instead, on the
     legacy windowBackground mechanism that clearly IS being respected. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/ic_launcher_background" />
    <item>
        <bitmap
            android:src="@drawable/splash_brand"
            android:gravity="center" />
    </item>
</layer-list>
